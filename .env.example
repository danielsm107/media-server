# General Configuration
PUID=1000
PGID=1000
TZ=Europe/Madrid

# FlareSolverr Configuration
LOG_LEVEL=info
LOG_HTML=false
CAPTCHA_SOLVER=none
PORT=8191

# Database Configuration (GameVault)
POSTGRES_USER=dbuser
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=gamevault_db
POSTGRES_DATA_PATH=./db/data

# GameVault Paths
GAMEVAULT_GAMES_PATH=./games
GAMEVAULT_GAMES_PATH2=./games2
GAMEVAULT_MEDIA_PATH=./media
GAMEVAULT_CONFIG_PATH=./config

# API Keys and Tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_token_here
CLOUDFLARE_DOMAINS=your.domain.com,another.domain.com
CLOUDFLARE_PROXIED=false

# GameVault API Configuration
METADATA_IGDB_CLIENT_ID=your_igdb_client_id_here
METADATA_IGDB_CLIENT_SECRET=your_igdb_client_secret_here

# Homarr Configuration
SECRET_ENCRYPTION_KEY=your_secure_encryption_key_here

# Note: Replace all "your_*_here" values with actual values before running the stack
# Keep this file private and never commit it to version control
